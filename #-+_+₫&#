local killHealthConnections = {}
local killHealthSnapshot = {}
local npcHumanoids = {}
local npcCacheConnection
local noHitLoopActive = false
local stopInstantKill
local stopInstantKillNoHit

local function clearNpcCache()
	disconnect(npcCacheConnection)
	npcCacheConnection = nil
	npcHumanoids = {}
end

local function cacheNpcHumanoid(humanoid)
	if humanoid:IsA("Humanoid") then
		npcHumanoids[humanoid] = true
		if state.instantKill and not killHealthConnections[humanoid] then
			local model = humanoid.Parent
			if model and not Players:GetPlayerFromCharacter(model) then
				killHealthSnapshot[humanoid] = humanoid.Health
				killHealthConnections[humanoid] = humanoid.HealthChanged:Connect(function(newHealth)
					local previousHealth = killHealthSnapshot[humanoid]
					killHealthSnapshot[humanoid] = newHealth
					if previousHealth and newHealth < previousHealth then
						pcall(function() humanoid.Health = 0 end)
					end
				end)
			end
		end
	end
end

local function buildNpcCache()
	clearNpcCache()
	local ai = Workspace:FindFirstChild("AI")
	if not ai then return false end

	for _, descendant in ipairs(ai:GetDescendants()) do
		cacheNpcHumanoid(descendant)
	end

	npcCacheConnection = connect(ai.DescendantAdded:Connect(cacheNpcHumanoid))
	return true
end

stopInstantKill = function()
	state.instantKill = false

	for humanoid, connection in pairs(killHealthConnections) do
		disconnect(connection)
		killHealthConnections[humanoid] = nil
	end
	killHealthSnapshot = {}
	clearNpcCache()
end

local function startInstantKill()
	stopInstantKillNoHit()
	if not buildNpcCache() then return end
	state.instantKill = true

	for humanoid in pairs(npcHumanoids) do
		pcall(function()
			local model = humanoid.Parent
			if not model or Players:GetPlayerFromCharacter(model) then return end
			killHealthSnapshot[humanoid] = humanoid.Health
			killHealthConnections[humanoid] = humanoid.HealthChanged:Connect(function(newHealth)
				local previousHealth = killHealthSnapshot[humanoid]
				killHealthSnapshot[humanoid] = newHealth
				if previousHealth and newHealth < previousHealth then
					pcall(function() humanoid.Health = 0 end)
				end
			end)
		end)
	end
end

stopInstantKillNoHit = function()
	state.instantKillNoHit = false
	noHitLoopActive = false
clearNpcCache()
end

local function startInstantKillNoHit()
	stopInstantKill()
	if not buildNpcCache() then return end
	state.instantKillNoHit = true
	noHitLoopActive = true

	task.spawn(function()
		while noHitLoopActive and state.instantKillNoHit do
			for humanoid in pairs(npcHumanoids) do
				pcall(function()
					local model = humanoid.Parent
					if model and humanoid.Health > 0 and not Players:GetPlayerFromCharacter(model) then
						humanoid.Health = 0
					end
				end)
			end
			task.wait(0.15)
		end
	end)
end

local TECH_STATS = { "STRENGTH", "TECH", "MORALE" }
local autoFarmToken = 0

local function getRootPart()
	local character = getCharacter()
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return character:FindFirstChild("HumanoidRootPart")
		or (humanoid and humanoid.RootPart)
		or character.PrimaryPart
end

local function isActive(token)
	return state.autoFarm and autoFarmToken == token
end

local function getEvent(name)
	local events = ReplicatedStorage:FindFirstChild("Events")
	return events and events:FindFirstChild(name)
end

local function getModesFolder()
	local gameValues = Workspace:FindFirstChild("GameValues")
	return gameValues and gameValues:FindFirstChild("GameModes")
end

local function hasVotedMode()
	local modes = getModesFolder()
	if not modes then return false end
	for _, mode in ipairs(modes:GetChildren()) do
		if mode:IsA("BoolValue") and mode.Value then
			return true
		end
	end
	return false
end

local function resolveModeName(input)
	local modes = getModesFolder()
	if modes then
		local lowered = string.lower(input)
		for _, mode in ipairs(modes:GetChildren()) do
			if string.lower(mode.Name) == lowered then
				return mode.Name
			end
		end
	end
	return input
end

local function getTechLevel(stat)
	local ok, level = pcall(function()
		local list = LocalPlayer.PlayerGui.Technology["Device Frame"].MainFrame.Top.ScrollingFrame
		local text = list[stat].Bar.Frame1.Level.Text
		return tonumber(string.match(text, "%d+"))
	end)
	if ok then return level end
	return nil
end

local function upgradeTechnology(token)
	local upgradeEvent = getEvent("UpgradeEvent")
	if not upgradeEvent then return end

	for _, stat in ipairs(TECH_STATS) do
		local lastLevel = getTechLevel(stat)
		local stalled = 0
		while isActive(token) and lastLevel and lastLevel < state.techLevel do
			upgradeEvent:FireServer(stat, "Normal Scrap")
			task.wait(0.1)
			local level = getTechLevel(stat)
			if level and level > lastLevel then
				stalled = 0
				lastLevel = level
			else
				stalled += 1
				if stalled >= 40 then break end
			end
		end
	end
end

local BOSS_HEALTH = 2000

local CLICK_REMOTE_ALIASES = {
	["prototype a 1.0"] = "ProtoA1",
	["prototype b 1.0"] = "ProtoBV1",
	["prototype a 2.0"] = "VideotaperV2",
	["prototype b 2.0"] = "BruteV2",
}

local function getClickRemoteName(name)
	local key = string.lower(string.match(name, "^%s*(.-)%s*$"))
	key = string.gsub(key, "%s+", " ")
	return CLICK_REMOTE_ALIASES[key] or name
end

local function findBestNpc(root, skipUntil)
	local ai = Workspace:FindFirstChild("AI")
	if not ai then return nil end

	local now = os.clock()
	local bestModel, bestHumanoid, bestPart, bestHealth, bestDistance
	for _, model in ipairs(ai:GetChildren()) do
		if model:IsA("Model")
			and not Players:GetPlayerFromCharacter(model)
			and not isAllyName(model.Name)
			and not (skipUntil[model] and skipUntil[model] > now) then
			local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
			local part = model:FindFirstChild("HumanoidRootPart")
				or model.PrimaryPart
				or model:FindFirstChildWhichIsA("BasePart", true)
			if humanoid and humanoid.Health > 0 and part then
				local health = humanoid.Health
				local distance = (part.Position - root.Position).Magnitude
				if not bestHealth
					or health < bestHealth
					or (health == bestHealth and distance < bestDistance) then
					bestModel, bestHumanoid, bestPart = model, humanoid, part
					bestHealth, bestDistance = health, distance
				end
			end
		end
	end
	return bestModel, bestHumanoid, bestPart
end

local ATTACK_DELAY = 0.1
local COMBO_STEP_DELAY = 0.25
local HOVER_HEIGHT = 140
local HOLD_INTERVAL = 0.05
local ROUND_RESET_DELAY = 5

local function setPlatformStand(value)
	local humanoid = getHumanoid()
	if humanoid then
		pcall(function() humanoid.PlatformStand = value end)
	end
end

local ROUND_END_CONFIRM = 3
local noVoteSince = nil

local function roundEnded()
	if not getModesFolder() or hasVotedMode() then
		noVoteSince = nil
		return false
	end
	noVoteSince = noVoteSince or os.clock()
	return os.clock() - noVoteSince >= ROUND_END_CONFIRM
end

local function attackNpc(token, model, humanoid, part, skipUntil)
	local startTime = os.clock()
	local lastRetarget = os.clock()
	local nextClickAt = 0
	local comboIndex = 0
	local isBoss = humanoid.MaxHealth >= BOSS_HEALTH

	local halfHeight = 3
	pcall(function()
		local _, size = model:GetBoundingBox()
		halfHeight = size.Y / 2
	end)

	while isActive(token) and model.Parent and part.Parent and humanoid.Health > 0 do
		local ownHumanoid = getHumanoid()
		local root = getRootPart()
		if not root or not ownHumanoid or ownHumanoid.Health <= 0 then return end

		if not ownHumanoid.PlatformStand then
			ownHumanoid.PlatformStand = true
		end

		local npcPosition = part.Position
		local hoverPosition = Vector3.new(npcPosition.X, npcPosition.Y + halfHeight + HOVER_HEIGHT, npcPosition.Z)
		root.CFrame = CFrame.new(hoverPosition) * CFrame.Angles(-math.pi / 2, 0, 0)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		if os.clock() >= nextClickAt then
			comboIndex += 1
			local step = comboIndex
			if comboIndex >= state.attackIndex then
				comboIndex = 0
				nextClickAt = os.clock() + ATTACK_DELAY
			else
				nextClickAt = os.clock() + COMBO_STEP_DELAY
			end
			pcall(function()
				local remotes = ReplicatedStorage:FindFirstChild("CharacterRemotes")
				local playableRemotes = remotes and remotes:FindFirstChild(getClickRemoteName(state.playableName))
				local click = playableRemotes and playableRemotes:FindFirstChild("Click")
				if click then
					click:FireServer(step)
				end
			end)
		end

		if os.clock() - lastRetarget >= 1 then
			lastRetarget = os.clock()
			if roundEnded() then return end
			local bestModel, bestHumanoid = findBestNpc(root, skipUntil)
			if bestModel and bestModel ~= model and bestHumanoid.Health < humanoid.Health then
				return
			end
		end

		if not isBoss and os.clock() - startTime > 20 then
			skipUntil[model] = os.clock() + 30
			return
		end
		task.wait(HOLD_INTERVAL)
	end
end

local function isReallyDead(token)
	local deadline = os.clock() + 2
	while isActive(token) and os.clock() < deadline do
		local humanoid = getHumanoid()
		if humanoid and humanoid.Health > 0 then
			return false
		end
		task.wait(0.25)
	end
	return isActive(token)
end

local function farmNpcs(token)
	local skipUntil = {}
	noVoteSince = nil
	while isActive(token) do
		local ownHumanoid = getHumanoid()
		local root = getRootPart()

		if not ownHumanoid or ownHumanoid.Health <= 0 then
			if isReallyDead(token) then
				break
			end
		else
			if roundEnded() then
				break
			end
			local model, humanoid, part
			if root then
				model, humanoid, part = findBestNpc(root, skipUntil)
			end
			if model then
				attackNpc(token, model, humanoid, part, skipUntil)
			else
				setPlatformStand(false)
				task.wait(0.5)
			end
		end
	end
	setPlatformStand(false)
end

local function waitForRespawn(token)
	while isActive(token) do
		local character = getCharacter()
		local humanoid = getHumanoid()
		if character and humanoid and humanoid.Health > 0 and getRootPart() then
			return
		end
		task.wait(0.5)
	end
end

local function autoFarmCycle(token)
	if not hasVotedMode() then
		local voteEvent = getEvent("ModeVote") or getEvent("ModeVoteEvent")
		if voteEvent then
			voteEvent:FireServer(resolveModeName(state.modeName))
		end
		task.wait(1)

		upgradeTechnology(token)
		if not isActive(token) then return end

		local readyEvent = getEvent("Ready")
		if readyEvent then
			readyEvent:FireServer()
		end
		task.wait(1)

		local equipRemote = ReplicatedStorage:FindFirstChild("EquipPlayable")
		if equipRemote then
			pcall(function()
				equipRemote:InvokeServer(state.playableName)
			end)
		end
		task.wait(0.5)

		local transformEvent = getEvent("TransformWithCutsceneRequest")
		if transformEvent then
			transformEvent:FireServer(state.playableName)
		end
		task.wait(2)
	else
		upgradeTechnology(token)
		if not isActive(token) then return end
	end

	farmNpcs(token)
	if not isActive(token) then return end

	waitForRespawn(token)
	while isActive(token) and hasVotedMode() do
		task.wait(0.5)
	end
	task.wait(ROUND_RESET_DELAY)
end

local function startAutoFarm()
	if state.autoFarm then return end
	state.autoFarm = true
	autoFarmToken += 1
	local token = autoFarmToken

	task.spawn(function()
		while isActive(token) do
			local ok = pcall(autoFarmCycle, token)
			if not ok then
				task.wait(1)
			end
		end
	end)
end

local function stopAutoFarm()
	state.autoFarm = false
	autoFarmToken += 1
	setPlatformStand(false)
end

