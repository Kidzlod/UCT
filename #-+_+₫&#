local function isAllyName(name)
	local charactersFolder = LocalPlayer:FindFirstChild("Characters")
	if not charactersFolder then return false end
	for _, folderName in ipairs(ALLY_FOLDERS) do
		local folder = charactersFolder:FindFirstChild(folderName)
		if folder and folder:FindFirstChild(name) then
