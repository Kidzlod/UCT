local function retryNpcEsp(model)
	if espRetrying[model] then return end
	espRetrying[model] = true

	task.spawn(function()
		for _ = 1, 20 do
			if not state.npcEsp or not model.Parent then break end
			task.wait(0.5)
			applyNpcHighlight(model)
			if model:FindFirstChild("FriXRewriteHealth") then break end
		end
		espRetrying[model] = nil
	end)
end

applyNpcHighlight = function(model)
	if not model:IsA("Model") then return end

	if isAllyName(model.Name) then
		local oldHighlight = model:FindFirstChild("FriXRewriteHighlight")
		if oldHighlight then oldHighlight:Destroy() end
		local oldHealth = model:FindFirstChild("FriXRewriteHealth")
		if oldHealth then oldHealth:Destroy() end
		return
	end

	local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
	if not humanoid then
		retryNpcEsp(model)
		return
end

	local highlight = model:FindFirstChild("FriXRewriteHighlight")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "FriXRewriteHighlight"
		highlight.Parent = model
	end

	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(255, 235, 70)
	highlight.FillTransparency = 0.35
	highlight.OutlineColor = Color3.fromRGB(255, 170, 20)
	highlight.OutlineTransparency = 0

	local adornee = model:FindFirstChild("Head")
		or model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChildWhichIsA("BasePart", true)
	if not adornee then
		retryNpcEsp(model)
		return
	end

	local billboard = model:FindFirstChild("FriXRewriteHealth")
	if not billboard then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "FriXRewriteHealth"
		billboard.Size = UDim2.fromOffset(130, 28)
		billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 10000
		billboard.Parent = model
	end
	billboard.Adornee = adornee

	local healthLabel = billboard:FindFirstChild("HealthLabel")
	if not healthLabel then
		healthLabel = Instance.new("TextLabel")
		healthLabel.Name = "HealthLabel"
		healthLabel.Size = UDim2.fromScale(1, 1)
		healthLabel.BackgroundTransparency = 1
		healthLabel.Font = Enum.Font.SourceSansBold
		healthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		healthLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		healthLabel.TextStrokeTransparency = 0
		healthLabel.TextSize = 16
		healthLabel.Parent = billboard
	end

	local function updateHealthText(health)
		healthLabel.Text = string.format("HP: %d / %d", math.max(0, math.floor(health + 0.5)), math.floor(humanoid.MaxHealth + 0.5))
	end

	updateHealthText(humanoid.Health)
	if not espHealthConnections[humanoid] then
		espHealthConnections[humanoid] = humanoid.HealthChanged:Connect(updateHealthText)
	end
	espRetrying[model] = nil
end

