local function getOwnedPartners()
	local characters = LocalPlayer:FindFirstChild("Characters")
	local partners = {}
	if not characters then return partners end

	for _, raceFolder in ipairs(characters:GetChildren()) do
		for _, partner in ipairs(raceFolder:GetChildren()) do
			if partner:IsA("BoolValue") and partner.Value then
				table.insert(partners, { race = raceFolder.Name, value = partner })
			end
		end
	end

	table.sort(partners, function(first, second)
		if first.race == second.race then
			return first.value.Name < second.value.Name
		end
		return first.race < second.race
	end)
	return partners
end

