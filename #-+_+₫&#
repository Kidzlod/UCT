local espConnection
local espHealthConnections = {}
local espModelHumanoids = {}
local espAdorneeRefresh = {}
local espToken = 0
local applyNpcHighlight

local function cleanupHumanoidEspConnection(humanoid)
	local tracked = espHealthConnections[humanoid]
	if not tracked then return end
	disconnect(tracked.health)
	disconnect(tracked.ancestry)
	if espModelHumanoids[tracked.model] == humanoid then
		espModelHumanoids[tracked.model] = nil
	end
	espHealthConnections[humanoid] = nil
end

local function removeNpcEsp(model)
	local highlight = model:FindFirstChild("FriXRewriteHighlight")
	if highlight then highlight:Destroy() end
	local billboard = model:FindFirstChild("FriXRewriteHealth")
	if billboard then billboard:Destroy() end
	espAdorneeRefresh[model] = nil
	local humanoid = espModelHumanoids[model]
	if not humanoid then
		humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
	end
	if humanoid then
		cleanupHumanoidEspConnection(humanoid)
	end
end

local function getEspAdornee(model, humanoid)
	local head = model:FindFirstChild("Head", true)
	if head and head:IsA("BasePart") then
		return head
	end

	local highestPart
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") and (not highestPart or descendant.Position.Y > highestPart.Position.Y) then
			highestPart = descendant
		end
	end
	return highestPart or humanoid.RootPart
end

local function updateEspText(model, humanoid)
	local billboard = model:FindFirstChild("FriXRewriteHealth")
	local label = billboard and billboard:FindFirstChild("HealthLabel")
	if label then
		label.Text = string.format("HP: %d / %d", math.max(0, math.floor(humanoid.Health + 0.5)), math.floor(humanoid.MaxHealth + 0.5))
	end
end

applyNpcHighlight = function(model)
	if not model:IsA("Model") then return end

	if isAllyName(model.Name) then
		removeNpcEsp(model)
		return
	end

	local humanoid = espModelHumanoids[model]
	if humanoid and not humanoid:IsDescendantOf(model) then
		cleanupHumanoidEspConnection(humanoid)
		humanoid = nil
	end
	if not humanoid then
		humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
		if humanoid then
			espModelHumanoids[model] = humanoid
		end
	end
	if not humanoid then return end

	if humanoid.Health <= 0 then
		removeNpcEsp(model)
		return
	end

	local billboard = model:FindFirstChild("FriXRewriteHealth")
	local adornee = billboard and billboard.Adornee
	local now = os.clock()
	if not adornee or not adornee:IsDescendantOf(model) or now - (espAdorneeRefresh[model] or 0) >= 1.5 then
		adornee = getEspAdornee(model, humanoid)
		espAdorneeRefresh[model] = now
	end
	if not adornee then return end

	local highlight = model:FindFirstChild("FriXRewriteHighlight")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "FriXRewriteHighlight"
		highlight.Adornee = model
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillColor = Color3.fromRGB(255, 235, 70)
		highlight.FillTransparency = 0.35
		highlight.OutlineColor = Color3.fromRGB(255, 170, 20)
		highlight.OutlineTransparency = 0
		highlight.Parent = model
	end

	if not billboard then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "FriXRewriteHealth"
		billboard.Size = UDim2.fromOffset(130, 28)
		billboard.StudsOffset = Vector3.new(0, 1.5, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 10000
		billboard.Adornee = adornee
		billboard.Parent = model

		local healthLabel = Instance.new("TextLabel")
		healthLabel.Name = "HealthLabel"
		healthLabel.Size = UDim2.fromScale(1, 1)
		healthLabel.BackgroundTransparency = 1
		healthLabel.Font = Enum.Font.SourceSansBold
		healthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		healthLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		healthLabel.TextStrokeTransparency = 0
		healthLabel.TextSize = 16
		healthLabel.Parent = billboard
	elseif billboard.Adornee ~= adornee then
		billboard.Adornee = adornee
	end

	updateEspText(model, humanoid)
	if not espHealthConnections[humanoid] then
		local tracked = { model = model }
		espHealthConnections[humanoid] = tracked
		tracked.health = humanoid.HealthChanged:Connect(function(health)
			if health <= 0 then
				removeNpcEsp(model)
			elseif model:FindFirstChild("FriXRewriteHealth") then
				updateEspText(model, humanoid)
			elseif state.npcEsp then
				applyNpcHighlight(model)
			end
		end)
		tracked.ancestry = model.AncestryChanged:Connect(function(_, parent)
			if parent == nil then
				removeNpcEsp(model)
			end
		end)
	end
end

local function stopNpcEsp()
	state.npcEsp = false
	espToken += 1
	disconnect(espConnection)
	espConnection = nil
	for humanoid in pairs(espHealthConnections) do
		cleanupHumanoidEspConnection(humanoid)
	end

	local ai = Workspace:FindFirstChild("AI")
	if ai then
		for _, model in ipairs(ai:GetChildren()) do
			removeNpcEsp(model)
		end
	end
end

local function startNpcEsp()
	if state.npcEsp then return end
	state.npcEsp = true
	espToken += 1
	local token = espToken

	local ai = Workspace:FindFirstChild("AI")
	if ai then
		for _, model in ipairs(ai:GetChildren()) do
			applyNpcHighlight(model)
		end
		espConnection = connect(ai.ChildAdded:Connect(function(model)
			if state.npcEsp then applyNpcHighlight(model) end
		end))
	end

	task.spawn(function()
		while state.npcEsp and espToken == token do
			local currentAi = Workspace:FindFirstChild("AI")
			if currentAi then
				for _, model in ipairs(currentAi:GetChildren()) do
					if not state.npcEsp or espToken ~= token then break end
					applyNpcHighlight(model)
				end
			end
			for humanoid in pairs(espHealthConnections) do
				if not currentAi or not humanoid:IsDescendantOf(currentAi) then
					cleanupHumanoidEspConnection(humanoid)
				end
			end
			task.wait(0.5)
		end
	end)
end

local killHealthConnections = {}
local killHealthSnapshot = {}
local npcHumanoids = {}
local npcCacheConnection
local noHitLoopActive = false
local instantKillPruneToken = 0
local stopInstantKill
local stopInstantKillNoHit

local function releaseNpcHumanoid(humanoid)
	disconnect(killHealthConnections[humanoid])
	killHealthConnections[humanoid] = nil
	killHealthSnapshot[humanoid] = nil
	npcHumanoids[humanoid] = nil
end

local function clearNpcCache()
	disconnect(npcCacheConnection)
	npcCacheConnection = nil
	for humanoid in pairs(npcHumanoids) do
		releaseNpcHumanoid(humanoid)
	end
	npcHumanoids = {}
end

local function trackInstantKillHumanoid(humanoid)
	if killHealthConnections[humanoid] then return end
	local model = humanoid.Parent
	if not model or Players:GetPlayerFromCharacter(model) then return end
	killHealthSnapshot[humanoid] = humanoid.Health
	killHealthConnections[humanoid] = humanoid.HealthChanged:Connect(function(newHealth)
		local previousHealth = killHealthSnapshot[humanoid]
		killHealthSnapshot[humanoid] = newHealth
		if newHealth <= 0 then
			releaseNpcHumanoid(humanoid)
		elseif previousHealth and newHealth < previousHealth then
			pcall(function() humanoid.Health = 0 end)
		end
	end)
end

local function cacheNpcHumanoid(humanoid)
	if not humanoid:IsA("Humanoid") then return end
	npcHumanoids[humanoid] = true
	if state.instantKill then
		trackInstantKillHumanoid(humanoid)
	end
end

local function buildNpcCache()
	clearNpcCache()
	local ai = Workspace:FindFirstChild("AI")
	if not ai then return false end

	for _, descendant in ipairs(ai:GetDescendants()) do
		cacheNpcHumanoid(descendant)
	end

	npcCacheConnection = connect(ai.DescendantAdded:Connect(cacheNpcHumanoid))
	return true
end

stopInstantKill = function()
	state.instantKill = false
	instantKillPruneToken += 1
	clearNpcCache()
end

local function startInstantKill()
	stopInstantKillNoHit()
	if not buildNpcCache() then return end
	state.instantKill = true

	for humanoid in pairs(npcHumanoids) do
		trackInstantKillHumanoid(humanoid)
	end
	instantKillPruneToken += 1
	local token = instantKillPruneToken
	task.spawn(function()
		while state.instantKill and instantKillPruneToken == token do
			task.wait(2)
			local ai = Workspace:FindFirstChild("AI")
			for humanoid in pairs(npcHumanoids) do
				if not ai or not humanoid:IsDescendantOf(ai) or humanoid.Health <= 0 then
					releaseNpcHumanoid(humanoid)
				end
			end
		end
	end)
end

stopInstantKillNoHit = function()
	state.instantKillNoHit = false
	noHitLoopActive = false
clearNpcCache()
end

local function startInstantKillNoHit()
	stopInstantKill()
	if not buildNpcCache() then return end
	state.instantKillNoHit = true
	noHitLoopActive = true

	task.spawn(function()
		while noHitLoopActive and state.instantKillNoHit do
			local ai = Workspace:FindFirstChild("AI")
			for humanoid in pairs(npcHumanoids) do
				if not ai or not humanoid:IsDescendantOf(ai) or humanoid.Health <= 0 then
					releaseNpcHumanoid(humanoid)
				else
					pcall(function()
						local model = humanoid.Parent
						if model and not Players:GetPlayerFromCharacter(model) then
							humanoid.Health = 0
						end
					end)
				end
			end
			task.wait(0.15)
		end
	end)
end

