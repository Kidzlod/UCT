	if not folder then return {} end

	local skills = {}
	for _, remote in ipairs(folder:GetChildren()) do
		if remote:IsA("RemoteEvent") and string.lower(remote.Name) ~= "click" then
			table.insert(skills, remote)
		end
	end
	return skills
end

local function getSelectedSkillRemotes()
	local folder = getPlayableRemoteFolder()
	if not folder then return {} end

	local selected = state.selectedSkills[folder.Name]
	if type(selected) ~= "table" then
		selected = {}
		state.selectedSkills[folder.Name] = selected
	end

	local skills = {}
	for _, remote in ipairs(getPlayableSkills()) do
		if selected[remote.Name] ~= false then
			table.insert(skills, remote)
		end
	end
	return skills
end

local function isSkillOnCooldown(skillName)
	local playerModel = Workspace:FindFirstChild(LocalPlayer.Name)
		or Workspace:FindFirstChild(LocalPlayer.DisplayName)
	local cooldowns = playerModel and playerModel:FindFirstChild("CooldownsFolder")
	local cooldown = cooldowns and cooldowns:FindFirstChild(skillName)
	if not cooldown then return false end

	if cooldown:IsA("BoolValue") then
		return cooldown.Value
	elseif cooldown:IsA("NumberValue") or cooldown:IsA("IntValue") then
		return cooldown.Value > 0
	elseif cooldown:IsA("StringValue") then
		return (tonumber(cooldown.Value) or 1) > 0
	end
	return true
end

local function getUsingSkillValue()
	local playerModel = Workspace:FindFirstChild(LocalPlayer.Name)
		or Workspace:FindFirstChild(LocalPlayer.DisplayName)
	local usingSkill = playerModel and playerModel:FindFirstChild("UsingSkill", true)
	if usingSkill and usingSkill:IsA("BoolValue") then
		return usingSkill
	end
	return nil
end

local function fireAndWaitForUsingSkill(token, model, humanoid, usingSkill, callback, duringAction)
	local sawSkillActive = false
	local finished = false
	local connection = usingSkill:GetPropertyChangedSignal("Value"):Connect(function()
		if usingSkill.Value then
			sawSkillActive = true
		elseif sawSkillActive then
			finished = true
		end
	end)
	local ok, result = xpcall(function()
		local callbackOk = pcall(callback)
		if not callbackOk then return false end

		while isActive(token) and model.Parent and humanoid.Health > 0 and not finished do
			if usingSkill.Value then
				sawSkillActive = true
			elseif sawSkillActive then
				finished = true
			end
			if not finished then
				if duringAction then
					pcall(duringAction)
				end
				task.wait(0.05)
			end
		end
		return true
	end, function()
		return false
	end)
	if connection.Connected then
		connection:Disconnect()
	end
	return ok and result == true
end

local cachedNpcModels = {}
local cachedNpcFolder
local cachedNpcAddedConnection
local cachedNpcRemovedConnection

local function clearCachedNpcModels()
	disconnect(cachedNpcAddedConnection)
	disconnect(cachedNpcRemovedConnection)
	cachedNpcAddedConnection = nil
	cachedNpcRemovedConnection = nil
	cachedNpcFolder = nil
	table.clear(cachedNpcModels)
end

local function getCachedNpcModels()
	local ai = Workspace:FindFirstChild("AI")
	if ai == cachedNpcFolder then
		return cachedNpcModels, ai
	end

	clearCachedNpcModels()
	cachedNpcFolder = ai
	if ai then
		for _, model in ipairs(ai:GetChildren()) do
			cachedNpcModels[model] = true
		end
		cachedNpcAddedConnection = connect(ai.ChildAdded:Connect(function(model)
			cachedNpcModels[model] = true
		end))
		cachedNpcRemovedConnection = connect(ai.ChildRemoved:Connect(function(model)
			cachedNpcModels[model] = nil
		end))
	end
	return cachedNpcModels, ai
end

local function findBestNpc(root, skipUntil)
	local npcModels, ai = getCachedNpcModels()
	if not ai then return nil end

	local now = os.clock()
	local bestModel, bestHumanoid, bestPart, bestHealth, bestDistance
	for model in pairs(npcModels) do
		if model:IsA("Model")
			and not Players:GetPlayerFromCharacter(model)
			and not isAllyName(model.Name)
			and not (skipUntil[model] and skipUntil[model] > now) then
			local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
			local part = model:FindFirstChild("HumanoidRootPart")
				or model.PrimaryPart
				or model:FindFirstChildWhichIsA("BasePart", true)
			if humanoid and humanoid.Health > 0 and part then
				local health = humanoid.Health
				local distance = (part.Position - root.Position).Magnitude
				if not bestHealth
					or health < bestHealth
					or (health == bestHealth and distance < bestDistance) then
					bestModel, bestHumanoid, bestPart = model, humanoid, part
					bestHealth, bestDistance = health, distance
				end
			end
		end
	end
	return bestModel, bestHumanoid, bestPart
end

local ATTACK_INTERVAL = 0.5

local function setPlatformStand(value)
	local humanoid = getHumanoid()
	if humanoid then
		pcall(function() humanoid.PlatformStand = value end)
	end
end

local function isModeSelectionOpen()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local modeSelection = playerGui and playerGui:FindFirstChild("Mode Selection")
	return modeSelection ~= nil and modeSelection.Enabled == true
end

local function roundEnded()
	return isModeSelectionOpen() and not hasVotedMode()
end

local function attackNpc(token, model, humanoid, part, skipUntil)
	local startTime = os.clock()
	local lastRetarget = os.clock()
	local pendingRetargetHealth
	local skills = getSelectedSkillRemotes()
	local skillIndex = 1
	local usingSkillValue = getUsingSkillValue()
	local isBoss = humanoid.MaxHealth >= BOSS_HEALTH

	local halfHeight = 3
	pcall(function()
		local _, size = model:GetBoundingBox()
		halfHeight = size.Y / 2
	end)
	local function maintainHover()
		local ownHumanoid = getHumanoid()
		local root = getRootPart()
		if not root or not ownHumanoid or ownHumanoid.Health <= 0 or not part.Parent then return end
		if not ownHumanoid.PlatformStand then
			ownHumanoid.PlatformStand = true
		end
		local npcPosition = part.Position
		local hoverPosition = Vector3.new(npcPosition.X, npcPosition.Y + halfHeight + state.hoverHeight, npcPosition.Z)
		root.CFrame = CFrame.new(hoverPosition) * CFrame.Angles(-math.pi / 2, 0, 0)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	while isActive(token) and model.Parent and part.Parent and humanoid.Health > 0 do
		local ownHumanoid = getHumanoid()
		local root = getRootPart()
		if not root or not ownHumanoid or ownHumanoid.Health <= 0 then return end

		if not ownHumanoid.PlatformStand then
			ownHumanoid.PlatformStand = true
		end

		maintainHover()

		if usingSkillValue and not usingSkillValue.Value then
			local readySkill = nil
			local readySkillIndex = nil
			for offset = 0, #skills - 1 do
				local index = ((skillIndex + offset - 1) % #skills) + 1
				if not isSkillOnCooldown(skills[index].Name) then
					readySkill = skills[index]
					readySkillIndex = index
					break
				end
			end
	
			if readySkill then
				local ok = fireAndWaitForUsingSkill(token, model, humanoid, usingSkillValue, function()
					readySkill:FireServer()
				end, maintainHover)
				if ok then
					skillIndex = readySkillIndex % #skills + 1
				end
			else
				local playableRemotes = getPlayableRemoteFolder()
				local click = playableRemotes and playableRemotes:FindFirstChild("Click")
				if click then
					fireAndWaitForUsingSkill(token, model, humanoid, usingSkillValue, function()
						click:FireServer(state.attackIndex)
					end, maintainHover)
				end
			end
		end

		if pendingRetargetHealth and (humanoid.Health <= 0 or humanoid.Health < pendingRetargetHealth) then
			return
		end

		if os.clock() - lastRetarget >= ATTACK_INTERVAL then
			lastRetarget = os.clock()
			if roundEnded() then return end
			if not pendingRetargetHealth then
				local bestModel, bestHumanoid = findBestNpc(root, skipUntil)
				if bestModel and bestModel ~= model and bestHumanoid.Health < humanoid.Health then
					pendingRetargetHealth = humanoid.Health
				end
			end
		end

		if not pendingRetargetHealth and not isBoss and os.clock() - startTime > 20 then
			skipUntil[model] = os.clock() + 30
			return
		end
		task.wait(0.05)
	end
end

local function isReallyDead(token)
	local deadline = os.clock() + 2
	while isActive(token) and os.clock() < deadline do
		local humanoid = getHumanoid()
		if humanoid and humanoid.Health > 0 then
			return false
		end
		task.wait(0.25)
	end
	return isActive(token)
end

local function farmNpcs(token)
	local skipUntil = {}
	while isActive(token) do
		local ownHumanoid = getHumanoid()
		local root = getRootPart()

		if not ownHumanoid or ownHumanoid.Health <= 0 then
			if isReallyDead(token) then
				break
			end
		else
			if roundEnded() then
				break
			end
			local model, humanoid, part
			if root then
				model, humanoid, part = findBestNpc(root, skipUntil)
			end
			if model then
				attackNpc(token, model, humanoid, part, skipUntil)
			else
				setPlatformStand(false)
				local baseThings = Workspace:FindFirstChild("BaseThings")
				local npcSpawnPosition = baseThings and baseThings:FindFirstChild("NPCSpawnPosition")
				local allies = npcSpawnPosition and npcSpawnPosition:FindFirstChild("Allies")
				local spawnPart = allies and allies:FindFirstChild("Part")
				if root and spawnPart and spawnPart:IsA("BasePart") then
					local offset = Vector3.new(
						spawnPart.Position.X - root.Position.X,
						0,
						spawnPart.Position.Z - root.Position.Z
					)
					root.CFrame += offset
					local velocity = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
					root.AssemblyAngularVelocity = Vector3.zero
				end
				task.wait(0.5)
			end
		end
	end
	setPlatformStand(false)
end

local function waitForRespawn(token)
	while isActive(token) do
		local character = getCharacter()
		local humanoid = getHumanoid()
		if character and humanoid and humanoid.Health > 0 and getRootPart() then
			return
		end
		task.wait(0.5)
	end
end

local function waitForModeSelection(token)
	while isActive(token) and not hasVotedMode() and not isModeSelectionOpen() do
		task.wait(0.25)
	end
end

local function autoFarmCycle(token)
	waitForModeSelection(token)
	if not isActive(token) then return end

	if not hasVotedMode() then
		local voteEvent = getEvent("ModeVote") or getEvent("ModeVoteEvent")
		if voteEvent then
			voteEvent:FireServer(resolveModeName(state.modeName))
		end
		task.wait(1)

		upgradeTechnology(token)
		if not isActive(token) then return end

		local readyEvent = getEvent("Ready")
		if readyEvent then
			readyEvent:FireServer()
		end
		task.wait(1)

		local equipRemote = ReplicatedStorage:FindFirstChild("EquipPlayable")
		if equipRemote then
			pcall(function()
				equipRemote:InvokeServer(state.playableName)
			end)
		end
		task.wait(0.5)

		local transformEvent = getEvent("TransformWithCutsceneRequest")
		if transformEvent then
			transformEvent:FireServer(state.playableName)
		end
		task.wait(2)
	else
		upgradeTechnology(token)
		if not isActive(token) then return end
	end

	farmNpcs(token)
	if not isActive(token) then return end

	waitForRespawn(token)
	while isActive(token) and hasVotedMode() do
		task.wait(0.5)
	end
end

local function startAutoFarm()
	if state.autoFarm then return end
	state.autoFarm = true
	autoFarmToken += 1
	local token = autoFarmToken

	task.spawn(function()
		while isActive(token) do
			local ok = pcall(autoFarmCycle, token)
			if not ok then
				task.wait(1)
			end
		end
	end)
end

local function stopAutoFarm()
	state.autoFarm = false
	autoFarmToken += 1
	clearCachedNpcModels()
	setPlatformStand(false)
end

local autoPurchaseUpgradeToken = 0

local function startAutoPurchaseUpgrade()
	if state.autoPurchaseUpgrade then return end
	state.autoPurchaseUpgrade = true
	autoPurchaseUpgradeToken += 1
	local token = autoPurchaseUpgradeToken

	task.spawn(function()
		local upgradeIndex = 1
		while state.autoPurchaseUpgrade and autoPurchaseUpgradeToken == token do
			local upgrades, playableName = getPlayableUpgradeNames(state.playableName)
			local purchaseItem = ReplicatedStorage:FindFirstChild("PurchaseItem")
			if #upgrades > 0 and playableName and purchaseItem then
				upgradeIndex = ((upgradeIndex - 1) % #upgrades) + 1
				pcall(function()
					purchaseItem:InvokeServer(playableName, upgrades[upgradeIndex])
				end)
				upgradeIndex += 1
			end
			task.wait(5)
		end
	end)
end

