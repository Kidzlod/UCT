end

local upgradeCache = {}
local upgradeModuleCandidates
local upgradeCacheOrder = {}
local UPGRADE_CACHE_LIMIT = 8

local function invalidateUpgradeModuleCache(instance)
	if not instance:IsA("ModuleScript") then return end
	upgradeModuleCandidates = nil
	table.clear(upgradeCache)
	table.clear(upgradeCacheOrder)
end

connect(ReplicatedStorage.DescendantAdded:Connect(invalidateUpgradeModuleCache))
connect(ReplicatedStorage.DescendantRemoving:Connect(invalidateUpgradeModuleCache))

local function cacheUpgradeResult(targetName, result)
	if not upgradeCache[targetName] then
		table.insert(upgradeCacheOrder, targetName)
	end
	upgradeCache[targetName] = result
	while #upgradeCacheOrder > UPGRADE_CACHE_LIMIT do
		local expiredName = table.remove(upgradeCacheOrder, 1)
		upgradeCache[expiredName] = nil
	end
end

local function getUpgradeModuleCandidates()
	if upgradeModuleCandidates then return upgradeModuleCandidates end
	local candidates = {}
	local modulesFolder = ReplicatedStorage:FindFirstChild("Modules")
		or ReplicatedStorage:FindFirstChild("Playables")
		or ReplicatedStorage:FindFirstChild("CharacterData")
	local searchRoot = modulesFolder or ReplicatedStorage
	for _, descendant in ipairs(searchRoot:GetDescendants()) do
		if descendant:IsA("ModuleScript") then
			table.insert(candidates, descendant)
		end
	end
	upgradeModuleCandidates = candidates
	return candidates
end

local function findPlayableUpgrades(data, targetName, visited, depth)
	if type(data) ~= "table" or depth > 8 or visited[data] then return nil end
	visited[data] = true

	for key, value in pairs(data) do
		if type(key) == "string" and normalizePlayableName(key) == targetName
			and type(value) == "table" and type(value.Upgrades) == "table" then
			return value.Upgrades, key
		end
	end

	for _, value in pairs(data) do
		local upgrades, playableKey = findPlayableUpgrades(value, targetName, visited, depth + 1)
		if upgrades then return upgrades, playableKey end
	end
	return nil
end

local function getPlayableUpgradeNames(playableName)
	local targetName = normalizePlayableName(playableName)
	local cached = upgradeCache[targetName]
	if cached ~= nil then
		return cached.names, cached.playableName
	end

	local candidateModules = table.clone(getUpgradeModuleCandidates())
	table.sort(candidateModules, function(first, second)
		local function priority(moduleScript)
			if normalizePlayableName(moduleScript.Name) == targetName then return 0 end
			local moduleName = string.lower(moduleScript.Name)
			if string.find(moduleName, "character") or string.find(moduleName, "playable")
				or string.find(moduleName, "upgrade") or string.find(moduleName, "data") then
				return 1
			end
			return 2
		end
		return priority(first) < priority(second)
	end)

	for _, moduleScript in ipairs(candidateModules) do
		local ok, moduleData = pcall(require, moduleScript)
		if ok then
			local upgrades, playableKey = findPlayableUpgrades(moduleData, targetName, {}, 0)
			if not upgrades and normalizePlayableName(moduleScript.Name) == targetName
				and type(moduleData) == "table" and type(moduleData.Upgrades) == "table" then
				upgrades, playableKey = moduleData.Upgrades, moduleScript.Name
			end
			if upgrades then
				local names = {}
				for upgradeName in pairs(upgrades) do
					if type(upgradeName) == "string" then
						table.insert(names, upgradeName)
					end
				end
				table.sort(names)
				cacheUpgradeResult(targetName, { names = names, playableName = playableKey })
				return names, playableKey
			end
		end
	end

	local emptyResult = { names = {}, playableName = nil }
	cacheUpgradeResult(targetName, emptyResult)
	return emptyResult.names, nil
end

local function getModesFolder()
	local gameValues = Workspace:FindFirstChild("GameValues")
	return gameValues and gameValues:FindFirstChild("GameModes")
end

local function hasVotedMode()
	local modes = getModesFolder()
	if not modes then return false end
	for _, mode in ipairs(modes:GetChildren()) do
		if mode:IsA("BoolValue") and mode.Value then
			return true
		end
	end
	return false
end

local function resolveModeName(input)
	local modes = getModesFolder()
	if modes then
		local lowered = string.lower(input)
		for _, mode in ipairs(modes:GetChildren()) do
			if string.lower(mode.Name) == lowered then
				return mode.Name
			end
		end
	end
	return input
end

local function getTechLevel(stat)
	local ok, level = pcall(function()
		local list = LocalPlayer.PlayerGui.Technology["Device Frame"].MainFrame.Top.ScrollingFrame
		local text = list[stat].Bar.Frame1.Level.Text
		return tonumber(string.match(text, "%d+"))
	end)
	if ok then return level end
	return nil
end

local function upgradeTechnology(token)
	local upgradeEvent = getEvent("UpgradeEvent")
	if not upgradeEvent then return end

	for _, stat in ipairs(TECH_STATS) do
		local lastLevel = getTechLevel(stat)
		local stalled = 0
		local targetLevel = state[TECH_LEVEL_KEYS[stat]]
		while isActive(token) and lastLevel and lastLevel < targetLevel do
			upgradeEvent:FireServer(stat, "Normal Scrap")
			task.wait(0.1)
			local level = getTechLevel(stat)
			if level and level > lastLevel then
				stalled = 0
				lastLevel = level
			else
				stalled += 1
				if stalled >= 40 then break end
			end
		end
	end
end

