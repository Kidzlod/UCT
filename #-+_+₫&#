	label.TextColor3 = COLORS.text
	label.Text = text
	label.TextSize = 15
	label.Font = Enum.Font.SourceSans
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 13
	label.Parent = row

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.6, -8, 1, -6)
	box.Position = UDim2.new(0.4, 2, 0, 3)
	box.BackgroundColor3 = COLORS.control
	box.TextColor3 = COLORS.text
	box.PlaceholderColor3 = Color3.fromRGB(80, 80, 80)
	box.Text = tostring(value)
	box.PlaceholderText = tostring(value)
	box.TextSize = 15
	box.Font = Enum.Font.SourceSans
	box.ClearTextOnFocus = true
	box.BorderColor3 = COLORS.border
	box.ZIndex = 13
	box.Parent = row
	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 8)
	boxCorner.Parent = box

	local current = tostring(value)
	box.FocusLost:Connect(function()
		local trimmed = string.match(box.Text, "^%s*(.-)%s*$")
		if trimmed ~= "" then
			current = trimmed
			callback(trimmed)
		end
		box.Text = current
	end)
end

local function createTab(name, order)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -12, 0, 38)
	button.Position = UDim2.fromOffset(6, 6 + (order - 1) * 44)
	button.BackgroundColor3 = name == currentTab and COLORS.controlOn or COLORS.control
	button.TextColor3 = COLORS.text
	button.Text = name
	button.TextSize = 16
	button.Font = Enum.Font.SourceSans
	button.BorderColor3 = COLORS.border
	button.AutoButtonColor = false
	button.ZIndex = 12
	button.Parent = sidebar
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button
	tabButtons[name] = button
	return button
end

local function showTab(name)
	currentTab = name
	for pageName, page in pairs(pages) do
		page.Visible = pageName == name
	end
	for tabName, button in pairs(tabButtons) do
		button.BackgroundColor3 = tabName == name and COLORS.controlOn or COLORS.control
	end
end

