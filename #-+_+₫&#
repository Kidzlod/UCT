local function canUseFiles()
	return type(isfile) == "function" and type(readfile) == "function" and type(writefile) == "function"
end

local function loadConfig()
	if not canUseFiles() then return end
	pcall(function()
		if not isfile(CONFIG_FILE) then return end
		local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
		if type(data) ~= "table" then return end
		for key, expectedType in pairs(CONFIG_KEYS) do
			if type(data[key]) == expectedType then
				state[key] = data[key]
			end
		end
		if type(data.techLevel) == "number" then
			for _, key in ipairs(LEVEL_KEYS) do
				if type(data[key]) ~= "number" then
					state[key] = data.techLevel
				end
			end
		end
	end)

	state.playableName = string.match(state.playableName, "^%s*(.-)%s*$")
	if state.playableName == "" then state.playableName = "Giant Screen" end
	state.modeName = string.match(state.modeName, "^%s*(.-)%s*$")
	if state.modeName == "" then state.modeName = "Easy" end
	for _, key in ipairs(LEVEL_KEYS) do
		state[key] = math.max(1, math.floor(state[key]))
	end
	state.hoverHeight = math.max(0, state.hoverHeight)
	state.attackIndex = math.clamp(math.floor(state.attackIndex), 1, 3)
end

local function saveConfig()
	if not canUseFiles() then return end
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
		local data = {}
		for key in pairs(CONFIG_KEYS) do
			data[key] = state[key]
		end
		writefile(CONFIG_FILE, HttpService:JSONEncode(data))
	end)
end

loadConfig()

local connections = {}
local function connect(connection)
	table.insert(connections, connection)
	return connection
end

local function disconnect(connection)
	if not connection then return end
	if connection.Connected then
		connection:Disconnect()
	end
	for index = #connections, 1, -1 do
		if connections[index] == connection then
			table.remove(connections, index)
			break
		end
	end
end

